# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
.vscode/settings.json
.vscode/tasks.json

# Build output (firmware only — Simulink dev build/ under Matlab Code/ is NOT firmware build)
Software/build/
Software/Debug/
Software/Release/

# Simulink dev build artifacts that exceed GitHub's 100MB push limit or are
# trivially regeneratable from checked-in build scripts. Source-of-truth is
# the .m build script; .mat files are caches.
Matlab Code/Simulink Development/**/*.mat
Matlab Code/Simulink Development/**/*.slxc
# Simulink JIT cache (per-run, machine-specific)
Matlab Code/Simulink Development/**/slprj/


# STM32CubeMX project file
*.ioc

# Startup/assembly files
*.s

# IDE files
*.id

# Middleware libraries
Middlewares/

# Windows reserved device names
nul

# CSV data files
CSVs/
*.csv
# Exception: Simulink simulator input trajectories live under inputs/ and are
# checked in (the reorg moved them out of CSVs/).
!Matlab Code/Simulink Development/inputs/*.CSV
!Matlab Code/Simulink Development/inputs/*.csv

# Build log
Software/build_out.txt

# Flight data images
*.png
# But keep Simulink dev plots (each task's plots/ subdir is part of the deliverable)
!Matlab Code/Simulink Development/**/*.png

# Python cache
__pycache__/

# Claude Code
.claude/

# Archives
*.zip

# Raw flash dumps (generated locally from USB MSC; can be 64+ MB)
flight_dump*.bin
*flash_dump*.bin
